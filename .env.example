# Optional AWS/Bedrock extension. Do not put secrets in this file.
RFS_BEDROCK_ENABLED=0
RFS_AWS_PROFILE=energy-ops
RFS_AWS_REGION=eu-west-2
RFS_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
RFS_BEDROCK_MAX_TOKENS=350

# Optional S3/Airflow release publishing.
RFS_S3_BUCKET=
RFS_S3_PREFIX=renewable-flexibility-studio
# Optional local/S3-compatible endpoint for tests; leave blank for AWS.
RFS_S3_ENDPOINT_URL=
RFS_RELEASE_REVISION=local
